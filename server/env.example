# Kolo server. Copy to server/server.env (gitignored). Never commit real keys.
# Network: mainnet (Arc, chain 5042) by default; KOLO_NETWORK=testnet selects Arc testnet (chain 5042002).
PORT=8787
KOLO_NETWORK=mainnet
# ARC_RPC_URL=https://rpc.mainnet.arc.io        # default per network
# KOLO_START_BLOCK=27463900                       # default per network (first Kolo deploy)
# Optional: keeper wallet for pull()/payTerm()/sweep()/CCTP relay. Without it the keeper runs in dry-run mode.
# Use a DEDICATED hot key with a tiny balance, never the deployer key. Set via `fly secrets set` in production.
KEEPER_PRIVATE_KEY=
KEEPER_INTERVAL_MS=60000
# Bearer token for POST /api/kolo/keeper/run and the admin application queue. Set via `fly secrets set`.
# KEEPER_RUN_TOKEN=
# KOLO_ADMIN_TOKEN=
# CORS: comma-separated allowed origins (default https://kolo-arc.vercel.app).
# KOLO_CORS_ORIGINS=https://kolo-arc.vercel.app
